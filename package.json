{
  "name": "spiff-ui-bridge",
  "version": "1.0.0",
  "description": "Standalone interceptor and orchestration bridge connecting SpiffWorkflow/Arena with metastruct domain laws and generic repository services.",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "test": "jest --config jest.config.js --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
